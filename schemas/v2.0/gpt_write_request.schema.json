{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GPT prediction write request 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_schema_version",
    "operation",
    "request_id",
    "nonce",
    "created_at",
    "expires_at",
    "repository",
    "source_snapshot_id",
    "source_generation_id",
    "source_snapshot_path",
    "prompt_version",
    "prompt_hash",
    "model_name",
    "model_configuration",
    "payload_sha256",
    "research_payload"
  ],
  "properties": {
    "request_schema_version": {
      "const": "1.0"
    },
    "operation": {
      "const": "persist_prediction_v2"
    },
    "request_id": {
      "type": "string",
      "pattern": "^gptw_[0-9a-f]{64}$"
    },
    "nonce": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "const": "Hughey-T/Daily-US-Stock-Screen"
    },
    "source_snapshot_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 100
    },
    "source_generation_id": {
      "type": "string",
      "pattern": "^gen_[0-9a-f]{64}$"
    },
    "source_snapshot_path": {
      "type": "string",
      "pattern": "^docs/generations/[0-9]{4}-[0-9]{2}-[0-9]{2}/gen_[0-9a-f]{64}/snapshot\\.json$"
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "prompt_hash": {
      "$ref": "#/$defs/hash"
    },
    "model_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "model_configuration": {
      "type": "object",
      "maxProperties": 10,
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean",
          "null"
        ]
      }
    },
    "payload_sha256": {
      "$ref": "#/$defs/hash"
    },
    "research_payload": {
      "$ref": "#/$defs/research"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "source_url",
        "published_at",
        "document_date",
        "information_cutoff_eligible"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        },
        "document_date": {
          "type": "string",
          "format": "date"
        },
        "information_cutoff_eligible": {
          "type": "boolean"
        }
      }
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "basis"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "basis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        }
      }
    },
    "forecast": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "horizon",
        "absolute_direction",
        "sector_relative_direction",
        "industry_relative_direction",
        "probability",
        "confidence",
        "benchmark_type",
        "benchmark_symbol",
        "benchmark_quality"
      ],
      "properties": {
        "horizon": {
          "enum": [
            21,
            63,
            126,
            252,
            504,
            756
          ]
        },
        "absolute_direction": {
          "enum": [
            "up",
            "down",
            "neutral"
          ]
        },
        "sector_relative_direction": {
          "enum": [
            "outperform",
            "underperform",
            "neutral",
            "unavailable"
          ]
        },
        "industry_relative_direction": {
          "enum": [
            "outperform",
            "underperform",
            "neutral",
            "unavailable"
          ]
        },
        "probability": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 0.99
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "benchmark_type": {
          "enum": [
            "industry",
            "peer_basket",
            "sector_etf",
            "SPY",
            "unavailable"
          ]
        },
        "benchmark_symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "benchmark_quality": {
          "enum": [
            "high",
            "medium",
            "low",
            "unavailable"
          ]
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_candidate_id",
        "verified_facts",
        "company_claims",
        "inferences",
        "research_status",
        "investment_stance",
        "situation_type",
        "research_priority",
        "valuation_status",
        "valuation_range",
        "estimation_method",
        "estimation_limitations",
        "primary_thesis",
        "falsifier",
        "research_completeness",
        "thesis_confidence",
        "forecast_applicable",
        "forecasts",
        "monitor_only_reason",
        "comparison_references"
      ],
      "properties": {
        "route_candidate_id": {
          "type": "string",
          "pattern": "^route_[0-9a-f]{64}$"
        },
        "verified_facts": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "company_claims": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "inferences": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/inference"
          }
        },
        "research_status": {
          "enum": [
            "ready_for_deep_dive",
            "conditional",
            "unresolved",
            "incomplete",
            "data_artifact",
            "excluded"
          ]
        },
        "investment_stance": {
          "enum": [
            "bullish_candidate",
            "bearish_candidate",
            "neutral_candidate",
            "not_assessed",
            "avoid_candidate"
          ]
        },
        "situation_type": {
          "enum": [
            "fundamental",
            "technical_supply_demand",
            "special_situation",
            "corporate_action",
            "data_anomaly",
            "unknown"
          ]
        },
        "research_priority": {
          "enum": [
            "high",
            "medium",
            "low",
            "none"
          ]
        },
        "valuation_status": {
          "enum": [
            "not_started",
            "partial",
            "range_estimated",
            "complete",
            "not_applicable",
            "not_estimable"
          ]
        },
        "valuation_range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "low",
            "base",
            "high"
          ],
          "properties": {
            "low": {
              "type": [
                "number",
                "null"
              ]
            },
            "base": {
              "type": [
                "number",
                "null"
              ]
            },
            "high": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        },
        "estimation_method": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1500
        },
        "estimation_limitations": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "primary_thesis": {
          "type": "string",
          "minLength": 10,
          "maxLength": 2500
        },
        "falsifier": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1500
        },
        "research_completeness": {
          "enum": [
            "complete",
            "partial",
            "incomplete"
          ]
        },
        "thesis_confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "forecast_applicable": {
          "type": "boolean"
        },
        "forecasts": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/forecast"
          }
        },
        "monitor_only_reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        },
        "comparison_references": {
          "type": "array",
          "maxItems": 15,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^route_[0-9a-f]{64}$"
          }
        }
      }
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidates"
      ],
      "properties": {
        "candidates": {
          "type": "array",
          "maxItems": 15,
          "items": {
            "$ref": "#/$defs/candidate"
          }
        }
      }
    }
  }
}
