{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Analysis layer contracts 3.0",
  "$defs": {
    "route": {"enum": ["event_anomaly", "quiet_drift"]},
    "mechanicalCandidate": {"type": "object", "additionalProperties": false, "required": ["candidate_id", "generation_id", "security_identity", "ticker", "route", "facts", "mechanical_signals"], "properties": {"candidate_id": {"type": "string"}, "generation_id": {"type": "string"}, "security_identity": {"type": "string"}, "ticker": {"type": "string"}, "route": {"$ref": "#/$defs/route"}, "facts": {"type": "object"}, "mechanical_signals": {"type": "object"}}},
    "exploratoryProposal": {"type": "object", "additionalProperties": false, "required": ["ticker", "security_identity", "proposal_reason", "evidence_refs", "proposed_route", "missing_mechanical_confirmation", "required_next_validation", "proposed_at", "source_cutoff", "status"], "properties": {"ticker": {"type": "string"}, "security_identity": {"type": "string"}, "proposal_reason": {"type": "string"}, "evidence_refs": {"type": "array", "items": {"type": "string"}}, "proposed_route": {"$ref": "#/$defs/route"}, "missing_mechanical_confirmation": {"type": "array", "items": {"type": "string"}}, "required_next_validation": {"type": "array", "items": {"type": "string"}}, "proposed_at": {"type": "string", "format": "date-time"}, "source_cutoff": {"type": "string", "format": "date-time"}, "status": {"enum": ["proposed", "pending_next_generation", "admitted", "rejected"]}}},
    "integratedDecision": {"type": "object", "additionalProperties": false, "required": ["candidate_id", "decision", "derived_from_ai_hash", "decided_at"], "properties": {"candidate_id": {"type": "string"}, "decision": {"enum": ["ADVANCE_TO_INDIVIDUAL_ANALYSIS", "RESEARCH_PRIORITY", "MONITOR", "EXPLORATORY_ONLY", "REJECT_DATA_ANOMALY", "REJECT_EXPLAINED_MOVE", "INSUFFICIENT_EVIDENCE", "NO_SELECTION"]}, "derived_from_ai_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "decided_at": {"type": "string", "format": "date-time"}}},
    "blindHandoff": {"type": "object", "additionalProperties": false, "required": ["handoff_version", "handoff_id", "generation_id", "candidate_id", "ticker", "security_identity", "facts", "source_refs", "data_quality", "investment_horizon", "unresolved_factual_questions"], "properties": {"handoff_version": {"const": "3.0"}, "handoff_id": {"type": "string"}, "generation_id": {"type": "string"}, "candidate_id": {"type": "string"}, "ticker": {"type": "string"}, "security_identity": {"type": "string"}, "facts": {"type": "object"}, "source_refs": {"type": "array", "items": {"type": "string"}}, "data_quality": {"type": "object"}, "investment_horizon": {"type": "string"}, "unresolved_factual_questions": {"type": "array", "items": {"type": "string"}}}},
    "reconciliationHandoff": {"type": "object", "additionalProperties": false, "required": ["handoff_version", "handoff_id", "blind_handoff_id", "blind_completed_at", "generation_id", "candidate_id", "mechanical_signals", "ai_judgment", "integrated_decision", "upstream_hypotheses", "disagreement", "unresolved_issues"], "properties": {"handoff_version": {"const": "3.0"}, "handoff_id": {"type": "string"}, "blind_handoff_id": {"type": "string"}, "blind_completed_at": {"type": "string", "format": "date-time"}, "generation_id": {"type": "string"}, "candidate_id": {"type": "string"}, "mechanical_signals": {"type": "object"}, "ai_judgment": {"type": "object"}, "integrated_decision": {"type": "object"}, "upstream_hypotheses": {"type": "array", "items": {"type": "string"}}, "disagreement": {"type": "string"}, "unresolved_issues": {"type": "array", "items": {"type": "string"}}}},
    "sessionState": {"type": "object", "additionalProperties": false, "required": ["session_id", "generation_id", "candidate_set_id", "mode", "phase"], "properties": {"session_id": {"type": "string"}, "generation_id": {"type": "string"}, "candidate_set_id": {"type": "string"}, "mode": {"enum": ["initial", "update"]}, "phase": {"type": "integer", "minimum": 1, "maximum": 8}}},
    "outcome": {"type": "object", "additionalProperties": false, "required": ["status", "maturity_date", "return_5d", "return_21d", "return_63d", "return_126d", "spy_excess", "sector_excess", "maximum_adverse_excursion", "maximum_favorable_excursion", "drawdown", "direction_accuracy"], "properties": {"status": {"enum": ["not_matured", "partially_matured", "matured"]}, "maturity_date": {"type": "string", "format": "date"}, "return_5d": {"type": ["number", "null"]}, "return_21d": {"type": ["number", "null"]}, "return_63d": {"type": ["number", "null"]}, "return_126d": {"type": ["number", "null"]}, "spy_excess": {"type": ["number", "null"]}, "sector_excess": {"type": ["number", "null"]}, "maximum_adverse_excursion": {"type": ["number", "null"]}, "maximum_favorable_excursion": {"type": ["number", "null"]}, "drawdown": {"type": ["number", "null"]}, "direction_accuracy": {"type": ["boolean", "null"]}}}
  },
  "type": "object", "additionalProperties": false,
  "required": ["analysis_contract_version", "machine_snapshot", "mechanical_candidates", "data_anomalies", "exploratory_proposals", "ai_judgments", "integrated_decisions", "decision_ledger", "outcomes", "blind_handoffs", "reconciliation_handoffs", "phase_artifacts", "update_diffs", "publication_manifest"],
  "properties": {"analysis_contract_version": {"const": "3.0"}, "machine_snapshot": {"type": "object"}, "mechanical_candidates": {"type": "array", "items": {"$ref": "#/$defs/mechanicalCandidate"}}, "data_anomalies": {"type": "array", "items": {"type": "object"}}, "exploratory_proposals": {"type": "array", "items": {"$ref": "#/$defs/exploratoryProposal"}}, "ai_judgments": {"type": "array", "items": {"type": "object"}}, "integrated_decisions": {"type": "array", "items": {"$ref": "#/$defs/integratedDecision"}}, "decision_ledger": {"type": "array", "items": {"type": "object"}}, "outcomes": {"type": "array", "items": {"$ref": "#/$defs/outcome"}}, "blind_handoffs": {"type": "array", "items": {"$ref": "#/$defs/blindHandoff"}}, "reconciliation_handoffs": {"type": "array", "items": {"$ref": "#/$defs/reconciliationHandoff"}}, "phase_artifacts": {"type": "array", "items": {"type": "object"}}, "update_diffs": {"type": "array", "items": {"type": "object"}}, "publication_manifest": {"type": "object"}}
}
