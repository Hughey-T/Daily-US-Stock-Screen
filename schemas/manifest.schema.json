{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_schema_version",
    "snapshot_id",
    "generation_id",
    "snapshot_path",
    "snapshot_sha256",
    "updated_at"
  ],
  "properties": {
    "manifest_schema_version": {
      "const": "2.0"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^snap_[0-9a-f]{64}$"
    },
    "generation_id": {
      "type": "string",
      "pattern": "^gen_[0-9a-f]{64}$"
    },
    "snapshot_path": {
      "type": "string",
      "pattern": "^generations/[0-9]{4}-[0-9]{2}-[0-9]{2}/gen_[0-9a-f]{64}/snapshot\\.json$"
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
