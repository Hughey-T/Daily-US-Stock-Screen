{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Immutable verification bundle 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verification_schema_version",
    "source_prediction_file",
    "source_prediction_sha256",
    "generated_at",
    "records"
  ],
  "properties": {
    "verification_schema_version": {
      "const": "2.0"
    },
    "source_prediction_file": {
      "type": "string"
    },
    "source_prediction_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "prediction_id",
          "verification_horizon",
          "outcome_status",
          "price_return",
          "total_shareholder_return",
          "spy_relative_return",
          "sector_relative_return",
          "mfe",
          "mae",
          "evaluation_group"
        ],
        "properties": {
          "outcome_status": {
            "enum": [
              "active",
              "cash_acquisition_completed",
              "stock_acquisition_completed",
              "delisted",
              "bankruptcy",
              "ticker_changed",
              "spinoff",
              "special_dividend",
              "adr_terminated",
              "liquidated",
              "not_yet_due",
              "data_unavailable"
            ]
          },
          "evaluation_group": {
            "enum": [
              "directional_forecast",
              "selection_comparison",
              "monitor_resolution"
            ]
          }
        }
      }
    },
    "future_stock_return": {
      "description": "Deprecated schema-1.1 field; present only for reader discovery",
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "future_spy_relative_return": {
      "description": "Deprecated schema-1.1 field; present only for reader discovery",
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "future_sector_relative_return": {
      "description": "Deprecated schema-1.1 field; present only for reader discovery",
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "max_favorable_excursion": {
      "description": "Deprecated schema-1.1 field; present only for reader discovery",
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "max_adverse_excursion": {
      "description": "Deprecated schema-1.1 field; present only for reader discovery",
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "max_upside_during_period": {
      "description": "Deprecated schema-1.1 field; present only for reader discovery",
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "max_drawdown_during_period": {
      "description": "Deprecated schema-1.1 field; present only for reader discovery",
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "absolute_direction_hit": {
      "description": "Deprecated schema-1.1 field; present only for reader discovery",
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "sector_relative_direction_hit": {
      "description": "Deprecated schema-1.1 field; present only for reader discovery",
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "outcome": {
      "description": "Deprecated schema-1.1 field; present only for reader discovery",
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "verification_date": {
      "description": "Deprecated schema-1.1 field; present only for reader discovery",
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "verification_data_source": {
      "description": "Deprecated schema-1.1 field; present only for reader discovery",
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    }
  }
}
